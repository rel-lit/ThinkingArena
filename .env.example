# ThinkingArena 服务商凭证（本文件为模板，复制为 .env 后填写）
# .env 已被 .gitignore 忽略，绝不提交。凭证纪律：不进 Bundle / Script / git。
# cli/run.ts 与 cli/dev-smoke.ts 启动时自动加载本目录 .env（已有环境变量优先）。

# DeepSeek（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=
# 可选：覆盖默认模型 id（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# Kimi / Moonshot AI（https://platform.moonshot.cn/）
MOONSHOT_API_KEY=
# 可选：覆盖默认模型 id（默认 kimi-k2-0711-preview）
# MOONSHOT_MODEL=kimi-k2-0711-preview
